# =============================================================
# DEAN / RESQLINK — Project .gitignore
# =============================================================

# --- Dependencies & Node Modules ---
node_modules/
web/node_modules/
.pnp
.pnp.js

# --- Next.js Build Output ---
.next/
web/.next/
out/
web/out/
build/
web/build/
dist/
*.tsbuildinfo
next-env.d.ts

# --- Environment Variables & Secrets ---
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
web/.env
web/.env*.local
!**/.env.example

# --- Logs & Debug Output ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.turbo

# --- Hardware / Embedded Compilation (Arduino & PlatformIO) ---
hardware/*.o
hardware/*.elf
hardware/*.hex
hardware/*.bin
hardware/.pio/
hardware/.vscode/
.pio/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- IDE & Editor Cache ---
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/c_cpp_properties.json
.clangd

# --- Vercel Deployment Cache ---
.vercel
